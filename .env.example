# Autofare — Environment Variables
# Copy this file to .env and fill in values.

# ── Required ──────────────────────────────────────────────
# (none — the app works out of the box for basic searches)

# ── Optional: LLM-powered proposals ──────────────────────
# Without this, autofare uses built-in strategies only (date shifts,
# alternate airports, hub routing). With it, an LLM proposes creative
# route ideas too.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Optional: Stripe billing ─────────────────────────────
# Without these, the billing page won't work but search still does.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_BUSINESS_PRICE_ID=price_...

# ── Backend config ───────────────────────────────────────
# JWT_SECRET=change-me-in-production
# AUTOFARE_DB=autofare.db
# CORS_ORIGINS=http://localhost:3000
